{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/simulations",
      "~/redis",
      "~/k8s",
      "~/prometheus-grafana"
    ],
    "allow": [
      "Bash(python3 tools/labq.py take *)",
      "Bash(python3 tools/labq.py show *)",
      "Bash(python3 tools/labq.py post *)",
      "Bash(python3 tools/labq.py status *)",
      "Bash(python3 tools/labq.py ask *)",
      "Bash(python3 tools/labq.py request *)",
      "Bash(python3 tools/labq.py withdraw *)",
      "Bash(python3 tools/labq.py pending)",
      "Bash(python3 tools/launch_run.py *)",
      "Bash(python3 -I tools/sanity_trivial_policies.py *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl version *)",
      "Bash(kubectl config get-contexts *)",
      "Bash(kubectl config current-context)",
      "Bash(nvidia-smi *)",
      "Bash(tmux ls *)",
      "Bash(git -C code status *)",
      "Bash(git -C code diff *)",
      "Bash(git -C code log *)",
      "Bash(git -C code add *)",
      "Bash(git -C code commit *)",
      "Bash(python3 tools/ask_peer.py *)",
      "Bash(python3 tools/build_md_index.py*)",
      "Bash(python3 tools/dispatcher.py status)",
      "Bash(git push github *)",
      "Bash(git -C * push github *)"
    ],
    "ask": [
      "Bash(git worktree *)",
      "Bash(kubectl config use-context *)",
      "Bash(sudo *)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(apt *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Bash(python3 tools/labq.py decide *)",
      "Bash(python3 tools/labq.py say *)",
      "Bash(sqlite3 *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl create *)",
      "Bash(kubectl scale *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl patch *)",
      "Bash(kubectl edit *)",
      "Bash(kubectl rollout *)",
      "Bash(kubectl replace *)",
      "Bash(helm *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Edit(~/simulations/**)",
      "Write(~/simulations/**)",
      "Edit(~/redis/**)",
      "Write(~/redis/**)",
      "Edit(~/k8s/**)",
      "Write(~/k8s/**)",
      "Edit(~/prometheus-grafana/**)",
      "Write(~/prometheus-grafana/**)",
      "Edit(.lab/lab.db)",
      "Write(.lab/lab.db)",
      "Edit(.lab/specs/**)",
      "Write(.lab/specs/**)",
      "Read(~/.ssh/**)",
      "Read(~/.codex/auth.json)",
      "Read(~/.qiskit/**)",
      "Read(~/.kube/config)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(python3 tools/sudo_grant.py *)",
      "Bash(python3 ./tools/sudo_grant.py *)",
      "Edit(tools/sudo_gate.py)",
      "Write(tools/sudo_gate.py)",
      "Edit(tools/sudo_grant.py)",
      "Write(tools/sudo_grant.py)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Bash(python3 tools/dispatcher.py set *)",
      "Bash(python3 tools/dispatcher.py clear *)",
      "Bash(python3 tools/dispatcher.py exhaust *)",
      "Bash(python3 tools/dispatcher.py run*)",
      "Bash(systemctl --user stop qrl-*)",
      "Bash(systemctl --user disable qrl-*)",
      "Edit(.lab/dispatch.db)",
      "Write(.lab/dispatch.db)",
      "Edit(tools/install_v03.py)",
      "Write(tools/install_v03.py)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push origin *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/lab_event_hook.py"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/lab_event_hook.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/lab_event_hook.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/lab_event_hook.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/sudo_gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/lab_event_hook.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/lab_event_hook.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/lab_event_hook.py"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/perm_hook.py",
            "timeout": 100
          }
        ]
      }
    ]
  }
}
